local ById: { [string]: MobDef } = {}
for _, m in ipairs(Catalog) do
	ById[m.Id] = m
end

local MobCatalog = {}
MobCatalog.All = Catalog
MobCatalog.ById = ById

function MobCatalog.ForStrip(faction: string, strip: number): { MobDef }
	local out: { MobDef } = {}
	for _, m in ipairs(Catalog) do
		if m.Faction == faction and m.Strip == strip then
			table.insert(out, m)
		end
	end
	return out
end

return MobCatalog
