--!strict
--[[
    AbilityCatalog (ModuleScript) -> ReplicatedStorage.Modules.AbilityCatalog
    HABILIDADES 3, 4, 5 y 6 de los 24 personajes. Datos puros; AbilityService las ejecuta y el HUD las muestra.
    Campos: Name, Text, Kind (tipo de efecto), Cost (energía), CdPve / CdPvp (recarga; en la Arena se usa CdPvp),
            Range, Radius, Duration, P (parámetros PvE), V (cambios en PvP).
    "Ref" = habilidad del personaje que sirve de base: 1 = Primaria, 2 = Secundaria (daño/cura × Frac/Mult).
    Para rebalancear una habilidad, edita solo su fila.
]]
export type Ability = {
	Name: string, Text: string, Kind: string, Cost: number, CdPve: number, CdPvp: number,
	Range: number, Radius: number, Duration: number, P: { [string]: any }, V: { [string]: any },
}

local A: { [string]: { [number]: Ability } } = {}
local function add(char: string, slot: number, a: Ability)
	A[char] = A[char] or {}
	A[char][slot] = a
end

